<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ir_module_module_hide_from_users" model="ir.rule">
        <field name="name">ir.module.module: hidden from plain internal users</field>
        <field name="model_id" ref="base.model_ir_module_module"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[(0, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="ir_module_module_visible_to_admins" model="ir.rule">
        <field name="name">ir.module.module: visible to administrators</field>
        <field name="model_id" ref="base.model_ir_module_module"/>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

</odoo>
